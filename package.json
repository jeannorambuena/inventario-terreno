{
  "name": "inventario-terreno",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación local y offline de inventario en terreno para Windows.",
  "type": "module",
  "scripts": {
    "backup": "node src/database/backup.js",
    "import": "node src/importer/run-import.js",
    "start": "node src/server.js",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "test:mobile": "vitest run tests/mobile.test.js",
    "test:watch": "vitest",
    "verify:field": "node scripts/verify-field-integrity.js",
    "backup:operational": "node src/database/operational-backup.js create",
    "backup:verify": "node src/database/operational-backup.js verify-latest",
    "backup:package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-operational-backup.ps1",
    "recovery:drill": "node scripts/recovery-drill.js",
    "pilot:ready": "npm test && npm run verify:field && npm run backup:operational && npm run backup:verify",
    "release:check": "node scripts/release-readiness.js",
    "pilot:preflight": "npm test && npm run verify:field && npm run backup:operational && npm run backup:verify && npm run release:check"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
